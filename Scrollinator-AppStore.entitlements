<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store build. build.sh adds the team and app identifiers from the provisioning profile. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Voice-activated scrolling, following your words, and recording. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Recordings go to ~/Music/Scrollinator Recordings by default... -->
    <key>com.apple.security.assets.music.read-write</key>
    <true/>
    <!-- ...or to a folder the user picks, remembered with a security-scoped bookmark. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
</dict>
</plist>
